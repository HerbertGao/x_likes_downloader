# X Likes Downloader 配置文件
# 复制此文件为 .env 并根据需要修改配置

# ========================================
# 用户认证信息 (通过 setup 命令自动生成)
# ========================================
# 认证与协议字段（cookies、bearer token、Likes/TweetDetail 端点等）
# 由 `xld setup` 从 cURL 中提取，写入凭据文件（默认存放于平台标准用户数据目录）。
# 不要在此文件中设置这些字段，否则会遮蔽 setup 写入的新值。

# ========================================
# 下载配置
# ========================================
# 每次获取的推文数量
COUNT=100

# 是否下载所有点赞推文 (true/false)
ALL=true

# 下载目录
DOWNLOAD_DIR=data/downloads

# 下载记录文件
DOWNLOAD_RECORD=data/downloaded_tweet_ids.txt

# 文件命名格式
FILE_FORMAT={USERNAME}_{ID}

# ========================================
# 文件整理配置
# ========================================
# 下载完成后自动整理文件 (true/false)
AUTO_ORGANIZE=true

# 整理目标目录
TARGET_DIR=data/organized

# 用户名别名映射文件 (可选)
# 在 DOWNLOAD_DIR 目录下创建 username_aliases.txt 文件
# 可将同一人的多个X账号归档到同一文件夹
# 格式：每行一组，逗号分隔，首个为主名称（匹配目标文件夹）
# 示例：
#   alice, alice_art, alice_photo
#   bob, bob_backup

# ========================================
# 调试配置
# ========================================
# 是否启用Mock模式 (true/false)
MOCK_MODE=false

# Mock数据文件路径
MOCK_LIKED_TWEETS_FILE=data/mock/mock_liked_tweets.json

# 日志级别 (debug, info, warn, error)
RUST_LOG=info
